{
    // Drive the build through the checked-in CMake presets (single source of truth).
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    // clangd provides IntelliSense from CMake's compile database; turn off the
    // cpptools engine so the two language servers do not fight over diagnostics.
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.detectExtensionConflicts": true,
    // Consistent formatting on save via .clang-format.
    "editor.formatOnSave": true,
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "clang-format.executable": "clang-format",
    // Match .editorconfig.
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
}
