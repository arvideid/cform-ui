{
    "version": "2.0.0",
    "problemMatchers": [
        {
            "name": "cform-gcc",
            "owner": "cpp",
            "source": "gcc",
            "fileLocation": [
                "${workspaceFolder}",
                "${workspaceFolder}/build/dev"
            ],
            "pattern": {
                "regexp": "^(.+?):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                "file": 1,
                "line": 2,
                "column": 3,
                "severity": 4,
                "message": 5
            }
        }
    ],
    "tasks": [
        {
            "label": "CMake: Configure (dev)",
            "detail": "cmake --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (dev)",
            "detail": "cmake --build --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "dependsOn": "CMake: Configure (dev)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$cform-gcc"
            ]
        },
        {
            "label": "CMake: Build (release)",
            "detail": "cmake --build --preset release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "group": "build",
            "problemMatcher": [
                "$cform-gcc"
            ]
        },
        {
            "label": "Test: ctest (dev)",
            "detail": "ctest --preset dev",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--preset",
                "dev"
            ],
            "dependsOn": "CMake: Build (dev)",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Clean: build trees",
            "detail": "Remove all CMake build directories",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "build"
            ],
            "problemMatcher": []
        }
    ]
}
