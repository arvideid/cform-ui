{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure (dev)",
            "detail": "cmake --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (dev)",
            "detail": "cmake --build --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (release)",
            "detail": "cmake --build --preset release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run: demo (dev)",
            "detail": "Build then run the example",
            "type": "shell",
            "command": "build/dev/bin/cform_demo",
            "dependsOn": "CMake: Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure (web)",
            "detail": "cmake --preset web (needs emsdk activated: source ./emsdk_env.sh)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "web"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (web)",
            "detail": "cmake --build --preset web",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "web"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run: demo (web)",
            "detail": "Serve build/web/bin at http://localhost:8000/cform_demo.html",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8000",
                "--directory",
                "build/web/bin"
            ],
            "dependsOn": "CMake: Build (web)",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Clean: build trees",
            "detail": "Remove all CMake build directories",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "build"
            ],
            "problemMatcher": []
        }
    ]
}
