{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure (dev)",
            "detail": "cmake --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (dev)",
            "detail": "cmake --build --preset dev",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (release)",
            "detail": "cmake --build --preset release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run: demo (dev)",
            "detail": "Build then run the example",
            "type": "shell",
            "command": "build/dev/bin/cform_demo",
            "dependsOn": "CMake: Build (dev)",
            "problemMatcher": []
        },
        {
            "label": "Clean: build trees",
            "detail": "Remove all CMake build directories",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "build"
            ],
            "problemMatcher": []
        }
    ]
