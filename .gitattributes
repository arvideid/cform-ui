# Normalize line endings across platforms.
* text=auto

# C / CMake / Markdown source
*.c    text eol=lf
*.h    text eol=lf
*.txt  text eol=lf
*.cmake text eol=lf
*.md   text eol=lf

# Golden snapshots are judged byte for byte against what the recorder held; a
# newline rewritten on checkout would fail every compare
*.golden -text

# JSON / YAML
*.json text eol=lf
*.yml  text eol=lf

# Tooling scripts run from CI and from a shell, where a CR breaks a shebang
*.py   text eol=lf

# The page shells are read as text by tools/check_docs.py, which matches whole lines in
# them: under text=auto a Windows checkout ends every line with a CR, and a pattern
# anchored at the end of a line then passes on one platform and fails on the other.
*.html text eol=lf

# These two carry the rules above. Left to text=auto, a Windows checkout reads
# them back with CRLF while the stored blob stays LF, and git then reports both
# as modified in every status.
.gitattributes text eol=lf
.gitignore     text eol=lf

# Windows binaries
*.exe  binary
*.dll  binary
*.lib  binary
*.a    binary
*.obj  binary

# Exclude repository-only files from release / git-archive exports
.gitattributes    export-ignore
.gitignore        export-ignore
.editorconfig     export-ignore
.clang-format     export-ignore
.clang-tidy       export-ignore
.clangd           export-ignore
.github/          export-ignore
CMakePresets.json export-ignore
CMakeUserPresets.json export-ignore
examples/         export-ignore
tests/            export-ignore
