# Normalize line endings across platforms.
* text=auto

# C / CMake / Markdown source
*.c    text eol=lf
*.h    text eol=lf
*.txt  text eol=lf
*.cmake text eol=lf
*.md   text eol=lf

# JSON / YAML
*.json text eol=lf
*.yml  text eol=lf

# Tooling scripts run from CI and from a shell, where a CR breaks a shebang
*.py   text eol=lf

# Windows binaries
*.exe  binary
*.dll  binary
*.lib  binary
*.a    binary
*.obj  binary

# Exclude repository-only files from release / git-archive exports
.gitattributes    export-ignore
.gitignore        export-ignore
.gitmessage       export-ignore
.editorconfig     export-ignore
.clang-format     export-ignore
.clang-tidy       export-ignore
.clangd           export-ignore
.github/          export-ignore
.vscode/          export-ignore
CMakePresets.json export-ignore
CMakeUserPresets.json export-ignore
example/          export-ignore
tests/            export-ignore
