# The prefix is where this file sits, not where the package was configured to
# install: a --prefix given only to `cmake --install` would otherwise leave a
# baked configure-time path pointing somewhere the files never landed. This
# file installs under ${exec_prefix}/lib/pkgconfig, so the prefix is two up.
prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: cform
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
# Deepest layer last: static archives resolve left to right, so a consumer
# that wants one floor drops the layers above the one it calls. The math
# library rides at the end because it is the layer below every one of them.
Libs: -L${libdir} -lcf_app -lcf_widget -lcf_node -lcf_paint -lcf_text -lcf_layout -lcf_theme -lcf_style -lcf_base@CFORM_PC_MATH@
