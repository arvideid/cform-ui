---
# Correctness-focused checks rather than a wall of style warnings.
#
# CI runs this over the 1.0 layers as a gate. The authoritative build warnings
# come from the compiler (see CMakeLists.txt); clangd gives live editor feedback
# from the same compile database.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  portability-*,
  performance-*

WarningsAsErrors: ''

# Only analyse headers that belong to this project.
HeaderFilterRegex: '^(include|src)/.*'

FormatStyle: file
