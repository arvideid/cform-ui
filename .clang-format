BasedOnStyle: LLVM

Language: Cpp
# The C values (c99, c11) were dropped from this key in clang-format 15; the
# dialect that actually compiles the code is CMake's C_STANDARD.
Standard: Latest

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 100

BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never

PointerAlignment: Right
DerivePointerAlignment: false

SortIncludes: CaseSensitive
